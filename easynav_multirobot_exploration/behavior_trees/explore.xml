<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="explore">
    <RetryUntilSuccessful num_attempts="-1">
      <Sequence>
        <GetPose pose="{p}"/>
        <ChooseFrontierGoal robot_pose="{p}"
                            frontier_goal="{fg}"/>
        <!-- <IsGoalValid new_goal="{fg}"/> -->
        <GoToPose goal_pose="{fg}"/>
        <IsExplored/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ChooseFrontierGoal"
            editable="true">
      <input_port name="robot_pose"
                  type="geometry_msgs::msg::Pose"/>
      <output_port name="frontier_goal"
                   type="geometry_msgs::msg::Pose"/>
    </Action>
    <Action ID="GetPose"
            editable="true">
      <output_port name="pose"
                  type="geometry_msgs::msg::Pose"/>
    </Action>
    <Action ID="GoToPose"
            editable="true">
      <input_port name="goal_pose"
                  type="geometry_msgs::msg::Pose"/>
    </Action>
    <Condition ID="IsExplored"
               editable="true">
    </Condition>
    <Condition ID="IsGoalValid"
               editable="true">
      <input_port name="new_goal"
                  type="geometry_msgs::msg::Pose"/>
    </Condition>
  </TreeNodesModel>

</root>
