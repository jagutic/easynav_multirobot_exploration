<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="explore">
    <ReactiveSequence>
      <GetExplorationData frontier="{f}"
                          pose="{p}"
                          peers_pose="{pp}"/>
      <ReactiveFallback>
        <IsExplored frontier_to_check="{f}"/>
        <ReactiveSequence>
          <ChooseFrontierGoal robot_pose="{p}"
                              peers_robot_pose="{pp}"
                              robot_frontier="{f}"
                              frontier_goal="{fg}"/>
          <ProcessGoal goal_with_cost="{fg}"
                        goal="{g}"/>
          <GoToPose goal_pose="{g}"/>
          <IsExplored frontier_to_check="{f}"/>
        </ReactiveSequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ChooseFrontierGoal"
            editable="true">
      <input_port name="robot_pose"
                  type="geometry_msgs::msg::Pose"/>
      <input_port name="peers_robot_pose"
                  type="std::vector&lt;geometry_msgs::msg::Pose&gt;"/>
      <input_port name="robot_frontier"
                  type="std::vector&lt;geometry_msgs::msg::Point&gt;"/>
      <output_port name="frontier_goal"
                   type="exploration_interfaces::msg::PoseWithCost"/>
    </Action>
    <Action ID="GetExplorationData"
            editable="true">
      <output_port name="frontier"
                   type="std::vector&lt;geometry_msgs::msg::Point&gt;"/>
      <output_port name="pose"
                   type="geometry_msgs::msg::Pose"/>
      <output_port name="peers_pose"
                   type="std::vector&lt;geometry_msgs::msg::Pose&gt;"/>
    </Action>
    <Action ID="GoToPose"
            editable="true">
      <input_port name="goal_pose"
                  type="geometry_msgs::msg::Pose"/>
    </Action>
    <Condition ID="IsExplored"
               editable="true">
      <input_port name="frontier_to_check"
                  type="std::vector&lt;geometry_msgs::msg::Point&gt;"/>
    </Condition>
    <Action ID="ProcessGoal"
            editable="true">
      <input_port name="goal_with_cost"
                  type="exploration_interfaces::msg::PoseWithCost"/>
      <output_port name="goal"
                   type="geometry_msgs::msg::Pose"/>
    </Action>
  </TreeNodesModel>

</root>
